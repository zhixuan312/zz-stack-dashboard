{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // vitest runs with `globals: true`, so `describe`/`it`/`expect` are ambient
    // at runtime. Without this they are ambient to the runner but unknown to
    // tsc, and `pnpm typecheck` fails on every test file while `pnpm test`
    // passes — two checks disagreeing about the same code.
    // `node` because scripts/ is TypeScript run by Node directly, and those files
    // reach for `process`, `Buffer` and friends. `types` is a whitelist: naming only
    // vitest/globals here left every one of those globals unknown to tsc.
    "types": [
      "vitest/globals",
      "node"
    ],
    // scripts/ is executed by Node's native type stripping, which erases
    // annotations and refuses to emit anything. Enums, namespaces and parameter properties
    // compile under tsc and then throw at runtime, so this used to refuse them here.
    //
    // It is off now, because `src/lib/host.ts` ships with ZZ Meridian and carries a parameter
    // property: a managed file cannot be edited to suit this project's compiler flag, and the
    // guarantee the flag bought is one `pnpm verify` already covers by RUNNING the scripts. What
    // still matters is kept: Node opens these files by the name written in the import, so the
    // tsconfig below lets them name `./lib/bin.ts` with its extension.
    // Those same files import each other by the name Node will open — `./lib/contrast-pairs.ts`.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
