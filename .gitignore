# DELIBERATE: the `!*` below re-includes this tree. Cloned inside the parent workspace, whose
# .gitignore is a single `*`, the tree is invisible to Tailwind v4's scanner, which walks up
# collecting .gitignore files: the build then emits no utilities and every page loses its
# layout. COUPLED: app/globals.css also names its sources with `@source`; keep both.
!*

# dependencies
node_modules
.pnpm-store

# build output
.next
out
build
.turbo
*.tsbuildinfo
next-env.d.ts

# test + coverage
coverage
test-results

# secrets and local overrides
.env
.env*.local
*.local

# deployment
.vercel

# logs
*-debug.log*
*-error.log*

# editors and OS
.DS_Store
.idea
.vscode

# throwaway scripts written at the repo root while iterating
/shot.mjs
/probe.mjs
